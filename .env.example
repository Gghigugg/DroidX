# Supabase server-side configuration. Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Internal server-to-server task API secret. Do not put it in client-side code.
IG_AGENT_INTERNAL_API_KEY=

# Optional AI provider configuration (server-side only; AI execution is not enabled by default).
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Meta Instagram Graph API — configure only after app review and required permissions.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
